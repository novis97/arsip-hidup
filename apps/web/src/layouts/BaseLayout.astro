---
import '../styles/tokens.css';
export interface Props {
  title: string; description: string; canonical: string;
  ogImage?: string; type?: 'website' | 'article'; jsonLd?: object[];
}
const { title, description, canonical, ogImage, type = 'website', jsonLd = [] } = Astro.props;
const isStaging = import.meta.env.PUBLIC_STAGING === '1';
const configuredSite = import.meta.env.PUBLIC_SITE_URL;

if (isStaging && !configuredSite) {
  throw new Error('PUBLIC_SITE_URL wajib disetel ketika PUBLIC_STAGING=1.');
}

const site = configuredSite ?? 'https://arsiphidup.id';
const pageCanonical = isStaging ? new URL(Astro.url.pathname, site).toString() : canonical;
const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const navigationItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Tentang', href: '/tentang' },
  { label: 'Koleksi', href: '/koleksi' },
  { label: 'Cerita', href: '/cerita' },
  { label: 'Belajar', href: '/belajar' },
  { label: 'Berpartisipasi', href: '/berpartisipasi' },
  { label: 'Berita', href: '/berita' },
  { label: 'Kontak', href: '/kontak' },
  { label: 'Rekomendasi Karya', href: '/rekomendasi-karya' },
];
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {isStaging && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={pageCanonical} />
  <link rel="alternate" hreflang="id" href={pageCanonical} />
  <link rel="alternate" hreflang="x-default" href={pageCanonical} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageCanonical} />
  <meta property="og:locale" content="id_ID" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Organization + WebSite: entitas konsisten di seluruh situs (GEO §7) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': ['Organization', 'ArchiveOrganization'],
        '@id': `${site}/#organization`,
        name: 'Arsip Hidup Indonesia',
        url: site,
        description:
          'Arsip Hidup Indonesia adalah platform arsip sejarah lisan yang mendokumentasikan pengetahuan, kehidupan, dan praktik pelaku budaya Indonesia, dan membukanya sebagai pintu masuk bagi peneliti serta publik.',
        sameAs: [], // TODO: isi dengan profil nyata. Kosong lebih baik daripada karangan.
      },
      { '@type': 'WebSite', '@id': `${site}/#website`, url: site, name: 'Arsip Hidup Indonesia', inLanguage: 'id-ID' },
      ...jsonLd,
    ],
  })} />
  <slot name="head" />
</head>
<body>
  {isStaging && (
    <div class="staging-banner" role="status">
      DATA UJI — Seluruh isi situs ini fiktif, termasuk nama narasumber, kutipan, liputan media, dan riwayat organisasi. Tidak ada wawancara nyata yang telah dilakukan. Halaman ini dipakai untuk menguji tampilan, bukan untuk dibaca sebagai informasi.
    </div>
  )}
  <a href="#konten" class="skip">Lewati ke konten</a>
  <header class="site-header">
    <nav aria-label="Utama">
      <details class="primary-navigation">
        <summary>Menu utama</summary>
        <ul>
          {navigationItems.map((item) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </header>
  <main id="konten"><slot /></main>
  <footer><p class="mono">© {new Date().getFullYear()} Arsip Hidup Indonesia</p></footer>
</body>
</html>

<style>
  .staging-banner {
    padding: var(--s3) var(--s4);
    background: var(--wedelan);
    color: var(--mori);
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.5;
    text-align: center;
  }

  .site-header {
    border-bottom: 1px solid currentColor;
    padding: var(--s3) var(--s4);
  }

  .primary-navigation summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
  }

  .primary-navigation ul {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    list-style: none;
    margin: var(--s3) 0 0;
    padding: 0;
  }

  .primary-navigation a[aria-current='page'] {
    font-weight: 700;
    text-decoration-thickness: 0.15em;
  }

  @media (min-width: 768px) {
    .primary-navigation summary {
      display: none;
    }

    .primary-navigation > ul,
    .primary-navigation:not([open]) > ul {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      margin-top: 0;
    }
  }
</style>
