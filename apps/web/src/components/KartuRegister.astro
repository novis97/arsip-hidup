---
/**
 * Elemen signature (DESIGN §3) sekaligus blok paling mudah dikutip mesin jawaban (GEO §4).
 * Dirender sebagai <dl> — data katalog, bukan hiasan.
 */
export interface Props {
  nomorArsip: string; direkamTanggal: string; direkamTempat: string;
  durasi: string; bahasa: string[]; narasumber: string;
  hak: string; akses: string;
}
const p = Astro.props;
---
<dl class="kartu-register mono">
  <div><dt>Arsip</dt><dd>{p.nomorArsip}</dd></div>
  <div><dt>Direkam</dt><dd>{p.direkamTanggal}, {p.direkamTempat}</dd></div>
  <div><dt>Durasi</dt><dd>{p.durasi}</dd></div>
  <div><dt>Bahasa</dt><dd>{p.bahasa.join(', ')}</dd></div>
  <div><dt>Narasumber</dt><dd>{p.narasumber}</dd></div>
  <div><dt>Hak</dt><dd>{p.hak}</dd></div>
  <div><dt>Akses</dt><dd>{p.akses}</dd></div>
</dl>
<style>
  .kartu-register { border-top: 2px solid var(--wedelan); border-bottom: 1px solid var(--wedelan);
    padding: var(--s4) 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--s2) var(--s5); }
  .kartu-register div { display: flex; gap: var(--s3); }
  .kartu-register dt { color: var(--nila-muda); min-width: 100px; text-transform: uppercase; font-size: 12px; letter-spacing: .06em; }
  .kartu-register dd { margin: 0; }
</style>
