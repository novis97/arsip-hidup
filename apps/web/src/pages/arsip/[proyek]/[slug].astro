---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArsipPlayer from '../../../components/player/ArsipPlayer.astro';
import KartuRegister from '../../../components/KartuRegister.astro';
import { getPublishedItems } from '../../../lib/payload';
import { convertLexicalToHTML } from '@payloadcms/richtext-lexical/html';

export async function getStaticPaths() {
  const items = await getPublishedItems();
  const payloadUrl = import.meta.env.PAYLOAD_URL ?? 'http://localhost:3000';

  return Promise.all(items.map(async (item: any) => {
    const transcriptUrl = new URL('/api/transcripts', payloadUrl);
    transcriptUrl.searchParams.set('where[archiveItem][equals]', String(item.id));
    transcriptUrl.searchParams.set('where[visibility][equals]', 'public');
    transcriptUrl.searchParams.set('limit', '1');
    transcriptUrl.searchParams.set('depth', '0');

    const response = await fetch(transcriptUrl);
    if (!response.ok) {
      throw new Error(`Gagal mengambil transkrip publik untuk arsip ${item.slug}.`);
    }
    const result = await response.json();

    return {
      params: { proyek: item.collection.slug, slug: item.slug },
      props: { item: { ...item, transcript: result.docs[0] } },
    };
  }));
}
const { item } = Astro.props;
const site = import.meta.env.PUBLIC_SITE_URL ?? 'https://arsiphidup.id';
const canonical = `${site}/arsip/${item.collection.slug}/${item.slug}`;

// PRD C-6 / RULES C-6 — nama dihormati sesuai display_consent DI SETIAP TEMPAT,
// termasuk title, meta description, dan schema. Kebocoran di satu titik = tidak ada anonimisasi.
const nama = item.contributors?.[0]?.narasumber;
const namaTampil = nama?.publicLabel ?? 'Narasumber';

const judulTampil = item.title ?? 'Arsip sejarah lisan';
const ringkasanTampil = item.summary;
let deskripsiTampil = item.description;
if (
  deskripsiTampil !== null &&
  typeof deskripsiTampil === 'object' &&
  'root' in deskripsiTampil
) {
  try {
    deskripsiTampil = convertLexicalToHTML({
      data: deskripsiTampil as Parameters<typeof convertLexicalToHTML>[0]['data'],
    });
  } catch (error) {
    throw new Error(`Gagal mengonversi description arsip ${item.slug}.`, { cause: error });
  }

  if (deskripsiTampil.trim().length === 0) {
    throw new Error(`Hasil konversi description arsip ${item.slug} kosong.`);
  }
}
const transkripTampil = item.transcript?.body;

const bahasaNames: Record<string, string> = {
  id: 'Indonesia',
  jv: 'Jawa',
};
const bahasaTampil = item.language.map((kode: string) => bahasaNames[kode] ?? kode);
const daftarBahasa = bahasaTampil.length > 1
  ? `${bahasaTampil.slice(0, -1).join(', ')} dan ${bahasaTampil.at(-1)}`
  : bahasaTampil[0];
const tanggalRekam = new Date(item.recordedAt).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const durasiJam = Math.floor(item.durationSeconds / 3600);
const durasiMenit = Math.floor((item.durationSeconds % 3600) / 60);
const durasiDetik = item.durationSeconds % 60;
const durasiRegister = [durasiJam, durasiMenit, durasiDetik]
  .map((bagian) => String(bagian).padStart(2, '0'))
  .join(':');
const durasiPanjang = [
  durasiJam > 0 ? `${durasiJam} jam` : undefined,
  durasiMenit > 0 ? `${durasiMenit} menit` : undefined,
  durasiDetik > 0 ? `${durasiDetik} detik` : undefined,
].filter(Boolean).join(' ');

const durasiISO = `PT${Math.floor(item.durationSeconds / 60)}M${item.durationSeconds % 60}S`;
const collectionId = `${site}/arsip/${item.collection.slug}#collection`;
const bolehTampilkanPerson = nama?.displayConsent === 'full_name';
const narasumberSchema = bolehTampilkanPerson ? [{
  '@type': 'Person',
  '@id': `${canonical}#narasumber`,
  name: namaTampil,
}] : [];

const collectionSchema = {
  '@type': 'Collection',
  '@id': collectionId,
  name: item.collection.title,
};

const videoSchema = item.videoSource === 'none' ? [] : [{
  '@type': 'VideoObject',
  '@id': `${canonical}#video`,
  name: judulTampil,
  description: ringkasanTampil,
  thumbnailUrl: [item.thumbnailUrl],
  uploadDate: new Date(item.recordedAt).toISOString(),
  duration: durasiISO,
  // VIDEO_EMBED §7 / RULES V-12: contentUrl TIDAK dicantumkan untuk aset terbatas.
  ...(item.accessTier === 'public' && item.videoSource === 'youtube'
    ? { embedUrl: `https://www.youtube-nocookie.com/embed/${item.youtubeId}` }
    : {}),
  transcript: transkripTampil ?? undefined,
  inLanguage: item.language,
  ...(bolehTampilkanPerson
    ? { creator: { '@id': `${canonical}#narasumber` } }
    : {}),
  isPartOf: { '@id': collectionId },
  publisher: { '@id': `${site}/#organization` },
  isAccessibleForFree: item.accessTier === 'public',
  ...(item.accessTier === 'restricted'
    ? { conditionsOfAccess: 'Akses melalui permohonan riset. Lihat /terlibat/akses-arsip.' }
    : {}),
}];

const archiveComponentSchema = {
  '@type': 'ArchiveComponent',
  '@id': `${canonical}#archive-component`,
  name: judulTampil,
  identifier: item.archiveNumber,
  dateCreated: item.recordedAt,
  locationCreated: { '@type': 'Place', name: item.recordedPlace },
  inLanguage: item.language,
  isAccessibleForFree: item.accessTier === 'public',
  ...(item.accessTier === 'restricted'
    ? { conditionsOfAccess: 'Akses melalui permohonan riset. Lihat /terlibat/akses-arsip.' }
    : {}),
  isPartOf: { '@id': collectionId },
  holdingArchive: { '@id': `${site}/#organization` },
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: `${site}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: item.collection.title,
      item: `${site}/arsip/${item.collection.slug}`,
    },
    { '@type': 'ListItem', position: 3, name: judulTampil, item: canonical },
  ],
};

const jsonLdSchema = [
  ...narasumberSchema,
  collectionSchema,
  ...videoSchema,
  archiveComponentSchema,
  breadcrumbSchema,
];
---
<BaseLayout
  title={`${judulTampil} — Arsip Hidup Indonesia`}
  description={ringkasanTampil}
  canonical={canonical}
  ogImage={item.thumbnailUrl}
  type="article"
  jsonLd={jsonLdSchema}
>
  <article>
    <h1>{judulTampil}</h1>

    <KartuRegister
      nomorArsip={item.archiveNumber}
      direkamTanggal={tanggalRekam}
      direkamTempat={item.recordedPlace}
      durasi={durasiRegister}
      bahasa={bahasaTampil}
      narasumber={namaTampil}
      hak={item.license}
      akses={item.accessTier === 'public' ? 'Terbuka' : 'Melalui permohonan'}
    />

    <ArsipPlayer
      videoSource={item.videoSource}
      youtubeId={item.youtubeId}
      thumbnailUrl={item.thumbnailUrl}
      title={judulTampil}
      durationSeconds={item.durationSeconds}
      itemId={item.id}
      accessTier={item.accessTier}
      caption={`${item.recordedPlace}, ${tanggalRekam}`}
      transcriptHref="#transkrip"
      fallbackMp4={item.fallbackMp4}
    />

    {item.transcript && (
      <section id="transkrip">
        <h2>Transkrip lengkap wawancara</h2>
        <!-- GEO §2: paragraf ini berdiri sendiri dan dirancang untuk dikutip apa adanya. -->
        <p class="transkrip-meta">
          Wawancara dengan {namaTampil} di {item.recordedPlace}. Direkam {tanggalRekam}.
          Durasi {durasiPanjang}. Bahasa {daftarBahasa}.
          Transkrip {item.transcript.isVerified ? 'sudah diverifikasi manusia' : 'hasil transkripsi otomatis dan BELUM diverifikasi'}.
        </p>
        <!-- Transkrip berada di HTML awal, tidak di-lazy-inject (GEO §1). -->
        <div class="transkrip" set:html={transkripTampil} />
      </section>
    )}

    <!--
    RULES C-1: summary TIDAK memenuhi syarat sebagai pengganti transkrip.
    Fallback ke summary dicabut di T1.6b karena membuat arsip yang lupa
    diisi description terlihat identik dengan yang sudah diisi.
    Seksi ini kosong = description memang kosong. Itu disengaja.
    -->
    {deskripsiTampil && (
      <section><h2>Tentang wawancara ini</h2><div set:html={deskripsiTampil} /></section>
    )}
  </article>
</BaseLayout>
