# ─── Salin ke .env dan isi. JANGAN pernah commit .env ───

# Domain kanonik (PRD B-1 — final: arsiphidup.id)
PUBLIC_SITE_URL=https://arsiphidup.id
PUBLIC_CDN_URL=https://cdn.arsiphidup.id
PAYLOAD_PUBLIC_SERVER_URL=https://api.arsiphidup.id

# Payload + SQLite (ARCHITECTURE §2.1)
PAYLOAD_SECRET=            # 32+ karakter acak: openssl rand -base64 48
DATABASE_URI=file:./payload.db

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_PUBLIC=ahi-public
R2_BUCKET_RESTRICTED=ahi-restricted

# Presigned URL — RULES V-9: TTL wajib <= 300 detik
SIGNED_URL_TTL_SECONDS=300

# AuditLog — SECURITY §7. Salt dirotasi harian oleh cron.
AUDIT_HASH_SALT=

# Email transaksional (notifikasi permohonan akses)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=arsip@arsiphidup.id

# Build hook Cloudflare Pages (dipanggil setelah publish)
DEPLOY_HOOK_URL=
